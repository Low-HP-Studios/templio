{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "templio-migration-preview",
  "account_id": "423419184139ad08e82cba83e7afb59c",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-17",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "keep_names": false,
  "previews": {
    "images": {
      "binding": "IMAGES"
    }
  }
}
